{
  "manifest_version": 3,
  "name": "Canvas Downloader - Bulk Save Course Files",
  "version": "1.10.0",
  "description": "Effortlessly bulk download Canvas course materials. One-click saver for modules and files.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content/api.js",
        "src/content/ui-builder.js",
        "src/content/content.js",
        "src/content/inject-ui.js"
      ],
      "css": [
        "src/content/inject-ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}