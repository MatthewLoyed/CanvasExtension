{
  "manifest_version": 3,
  "name": "Canvas LMS Bulk Downloader & Resource Saver",
  "version": "1.1.0",
  "description": "Effortlessly bulk download files from Canvas LMS modules and pages. One-click resource saver.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js",
        "inject-ui.js"
      ],
      "css": [
        "inject-ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}