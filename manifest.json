{
  "manifest_version": 3,
  "name": "Canvas Downloader - Bulk Save Course Files",
  "version": "1.12.1",
  "description": "Save available Canvas course content and attachments in an offline ZIP, or bulk download selected module files.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content/api.js",
        "src/content/course.js",
        "src/content/ui-builder.js",
        "src/content/content.js",
        "src/content/inject-ui.js",
        "src/vendor/purify.min.js",
        "src/vendor/jszip.min.js",
        "src/offline/transport.js",
        "src/offline/core.js",
        "src/offline/io.js",
        "src/offline/styles.js",
        "src/offline/modal.js",
        "src/content/offline-entry.js"
      ],
      "css": [
        "src/content/inject-ui.css",
        "src/offline/modal.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}
